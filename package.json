{
  "name": "facet",
  "version": "0.2.10",
  "private": true,
  "description": "Independent multi-instance browser with explicit direct networking and bundled Mihomo",
  "author": "HEYD66",
  "license": "MIT",
  "homepage": "https://github.com/HEYD66/facet",
  "main": "src/main/main.cjs",
